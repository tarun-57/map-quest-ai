# Copy to .env.local for local development (never commit .env with secrets).

# Google Maps JavaScript API key (Street View + Maps). Restrict by HTTP referrer in GCP.
REACT_APP_GCP_API_KEY=

# Optional: backend origin (e.g. http://localhost:3300). Leave empty to use same-origin
# /api (nginx in Docker) or CRA dev server "proxy" in package.json.
REACT_APP_API_BASE_URL=
